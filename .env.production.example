# Copy this file to .env.production and replace every placeholder before launch.
# Docker Compose reads it with: docker compose --env-file .env.production ...
# Keep this URL-safe because it is embedded in DATABASE_URL by Compose.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-with-a-long-url-safe-database-password
# Generate independently with the same command.
SECRET_KEY=replace-with-at-least-64-random-characters
PUBLIC_APP_URL=https://catalogue.example.com
NEXT_PUBLIC_API_URL=/api
CORS_ORIGINS=https://catalogue.example.com

# Bind to loopback when an HTTPS reverse proxy runs on this host.
# Use 0.0.0.0 only for an intentionally LAN-exposed deployment.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
