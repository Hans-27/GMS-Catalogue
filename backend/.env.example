APP_NAME=GMS Catalogue Management API
APP_ENV=development
API_PREFIX=/api

# Replace every value with the PostgreSQL connection configured in pgAdmin 4.
DATABASE_URL=postgresql+psycopg://catalogue_user:change-me@localhost:5432/catalogue_management

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_ISSUER=gms-catalogue
ACCESS_TOKEN_MINUTES=180
REMEMBER_ME_DAYS=14
AUTH_COOKIE_NAME=catalogue_session
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost,http://127.0.0.1
# Optional anchored regex for trusted dynamic HTTPS tunnel origins.
CORS_ORIGIN_REGEX=
# Customer-facing origin used when secure catalogue URLs are generated.
PUBLIC_APP_URL=http://localhost
DESIGN_EXPORT_WORKER_ENABLED=true
DESIGN_EXPORT_POLL_SECONDS=2
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Convenient for the first local milestone. Use migrations and set false later.
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true
UPLOAD_DIR=./uploads
PRODUCT_IMAGE_MAX_SIZE_MB=50
COVER_UPLOAD_DIR=./private_uploads/catalogue-covers
MAX_COVER_UPLOAD_MB=20
MAX_COVER_DIMENSION=12000
MAX_UPLOAD_MB=8
PRODUCT_VIDEO_UPLOAD_DIR=./private_uploads/product-videos
PRODUCT_VIDEO_MAX_SIZE_MB=100
PRODUCT_VIDEO_MAX_DURATION_SECONDS=600
PRODUCT_VIDEO_ALLOWED_TYPES=video/mp4,video/webm
PRODUCT_VIDEO_YOUTUBE_ENABLED=true
PRODUCT_VIDEO_VIMEO_ENABLED=true
PRODUCT_VIDEO_DIRECT_URL_ENABLED=false
MAX_COVER_UPLOAD_MB=20
MIN_COVER_WIDTH=800
MIN_COVER_HEIGHT=600
BACKUP_DIR=./backups
APPLICATION_ROOT=..
# Windows example: C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
PG_DUMP_PATH=pg_dump
ENABLE_BACKUP_RESTORE=false
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=10
HEALTH_CPU_WARNING=85
HEALTH_MEMORY_WARNING=85
HEALTH_DISK_WARNING=85
HEALTH_DATABASE_MS_WARNING=500
DEMO_MODE=true
DEMO_VERSION=demo-0.2.0
FEEDBACK_ENABLED=true

# Dedicated MSSQL -> application database product-source synchronization.
# ERP credentials are saved encrypted through SuperAdmin Settings > ERP.
PRODUCT_SYNC_ENABLED=true
PRODUCT_SYNC_INTERVAL_SECONDS=180
PRODUCT_SYNC_BATCH_SIZE=500
PRODUCT_SYNC_STALE_WARNING_SECONDS=360
PRODUCT_SYNC_STALE_CRITICAL_SECONDS=900
PRODUCT_SYNC_SOURCE=MSSQL
PRODUCT_SYNC_TIMEZONE=Asia/Bangkok
PRODUCT_SYNC_MAX_RETRIES=3
PRODUCT_SYNC_LOCK_SECONDS=900
PRODUCT_SYNC_PRICE_MAPPING=Price01:NORMAL,Price02:VIP,Price03:BIG_CUSTOMER,Price04:DEALER,Price05:WHOLESALE

# Purchase-order data shown in the catalogue card's INTRANSIT / ORDER row.
PURCHASE_ORDER_API_URL=http://gms25.homeip.net/pm/index.php?r=site/POListApi&id=
PURCHASE_ORDER_API_TIMEOUT_SECONDS=5
PURCHASE_ORDER_API_CACHE_SECONDS=60

# Read-only legacy catalogue ordering reference. Do not commit real credentials.
LEGACY_CATALOGUE_URL=http://gms25.homeip.net/catalogue/index.php?r=sale/index
LEGACY_CATALOGUE_USERNAME=
LEGACY_CATALOGUE_PASSWORD=
