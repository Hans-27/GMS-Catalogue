# Browser audit server and installed Chromium channel
GMS_E2E_BASE_URL=http://127.0.0.1:3000
GMS_E2E_BROWSER_CHANNEL=chrome
# Keep 0 while the normal development server is already running. Use 1 only
# in an isolated test environment where Playwright should own the server.
GMS_E2E_MANAGE_SERVER=0

# Required authenticated tracer account
GMS_E2E_SUPERADMIN_IDENTIFIER=
GMS_E2E_SUPERADMIN_PASSWORD=

# Later full role/route matrix
GMS_E2E_SALES_ADMIN_IDENTIFIER=
GMS_E2E_SALES_ADMIN_PASSWORD=
GMS_E2E_SALES_IDENTIFIER=
GMS_E2E_SALES_PASSWORD=
GMS_E2E_CUSTOMER_IDENTIFIER=
GMS_E2E_CUSTOMER_PASSWORD=
GMS_E2E_CUSTOMER_ACCESS_CODE=
GMS_E2E_CATALOGUE_ID=
GMS_E2E_STUDIO_DESIGN_ID=
GMS_E2E_PROMOTION_ID=
GMS_E2E_PUBLIC_CATALOGUE_TOKEN=
GMS_E2E_PUBLIC_PROMOTION_TOKEN=
GMS_E2E_ROLE_ID=
